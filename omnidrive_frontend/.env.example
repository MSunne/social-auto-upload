# Copy this file to .env.local before local development.

# Frontend dev/start port
PORT=3000

# OmniDrive cloud backend address for local development.
# In production, set this to the public API origin, for example:
# https://aitoplus.com/api/v1
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8410/api/v1

# Only turn on if you explicitly want frontend mock fallback for non-auth pages
NEXT_PUBLIC_USE_MOCK=false
