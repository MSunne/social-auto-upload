# Copy this file to .env.local before local development.

# Admin frontend dev/start port
PORT=3001

# OmniDrive admin backend host for local development.
# In production, set this to the public admin origin, for example:
# https://ad.aitoplus.com
NEXT_PUBLIC_OMNIDRIVE_ADMIN_API_BASE_URL=http://127.0.0.1:8410
