[Unit]
Description=OmniDrive admin frontend
After=network-online.target omnidrive-api.service
Wants=network-online.target

[Service]
Type=simple
User=omnidrive
Group=omnidrive
WorkingDirectory=/opt/omnidrive/OmniDriveAdmin
EnvironmentFile=/etc/omnidrive/omnidrive-admin.env
ExecStart=/usr/bin/env npm run start
Restart=always
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
