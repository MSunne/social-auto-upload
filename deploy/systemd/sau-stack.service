[Unit]
Description=SAU backend and sau_frontend stack
After=network-online.target graphical.target
Wants=network-online.target

[Service]
Type=simple
PermissionsStartOnly=true
User=sun
Group=sun
WorkingDirectory=/opt/omnibull/social-auto-upload
Environment=HOME=/home/sun
EnvironmentFile=-/etc/omnibull/omnibull.env
ExecStartPre=+/usr/bin/install -d -o root -g sun -m 0775 /etc/omnibull
ExecStart=/opt/omnibull/social-auto-upload/scripts/sau_linux.sh run
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=graphical.target
